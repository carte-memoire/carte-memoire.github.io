# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (tableau de bord → Project Settings → API Keys).
# Uniquement la clé PUBLIQUE : jamais de clé secrète (service_role / sb_secret_…) ici.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
